<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Serviço em primeiro plano mantém a sessão MQTT viva com o app fechado.
         Desde o Android 14 o tipo é obrigatório e precisa ser justificado. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Notificações passaram a exigir consentimento em runtime no Android 13. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Removidas em relação ao app de 2017:
        WAKE_LOCK             - o Paho pedia; o HiveMQ não precisa e ela custa bateria.
        READ_PHONE_STATE      - permissão perigosa, pedida sem qualquer uso real.
        RECEIVE_BOOT_COMPLETED- o app nunca implementou nada no boot.
      Permissão que não é usada é superfície de ataque e motivo de rejeição na Play Store.
    -->

    <application
        android:name=".PulsoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pulso.Splash"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Pulso.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MqttForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
